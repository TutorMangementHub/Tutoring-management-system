<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · Tutor Hub</title>
    <link rel="stylesheet" href="/css/groups.css">
</head>
<body class="workspace-body">
    <div class="workspace-shell">
        <%- include('../partials/teacher-sidebar', { active: 'groups', teacher }) %>
        <main class="workspace-main">
            <div class="workspace-content">
                <header class="page-heading page-heading-row">
                    <div>
                        <h1>Available groups</h1>
                        <p>Check the groups currently available to students.</p>
                    </div>
                    <a class="primary-button add-group-button" href="/groups/new">+ Add group</a>
                </header>

                <form class="group-filters" method="get" action="/groups">
                    <input type="search" name="search" value="<%= search %>" placeholder="Search groups by name" aria-label="Search groups by name">
                    <select name="gradeId" aria-label="Filter by grade">
                        <option value="">All grades</option>
                        <% grades.forEach((grade) => { %>
                            <option value="<%= grade._id %>" <%= String(gradeId) === String(grade._id) ? 'selected' : '' %>><%= grade.level %></option>
                        <% }) %>
                    </select>
                    <button class="filter-button" type="submit">Filter</button>
                    <% if (search || gradeId) { %><a class="clear-filter" href="/groups">Clear</a><% } %>
                </form>

                <% if (groups.length === 0) { %>
                    <section class="empty-card">
                        <h2>No groups yet</h2>
                        <p>Add your first group so students can choose it during registration.</p>
                        <a class="primary-button" href="/groups/new">+ Add group</a>
                    </section>
                <% } else { %>
                    <section class="group-list" aria-label="Available groups">
                        <% groups.forEach((group) => { %>
                            <article class="group-row">
                                <div>
                                    <h2><%= group.name %></h2>
                                    <p><%= group.gradeId?.level || 'Grade' %> · <%= group.studentCount %> students</p>
                                </div>
                                <span class="status-badge <%= group.isActive ? 'is-active' : 'is-inactive' %>"><%= group.isActive ? 'Active' : 'Inactive' %></span>
                                <div class="group-actions">
                                    <a class="secondary-button view-students-button" href="/groups/<%= group._id %>/students">View students</a>
                                    <a class="secondary-button" href="/groups/<%= group._id %>/slots">Set free time</a>
                                </div>
                            </article>
                        <% }) %>
                    </section>
                    <% const pageCount = Math.max(1, Math.ceil(total / pageSize)); %>
                    <% if (pageCount > 1) { %>
                        <nav class="pagination" aria-label="Groups pagination">
                            <% if (page > 1) { %><a href="/groups?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>&gradeId=<%= encodeURIComponent(gradeId) %>">← Previous</a><% } else { %><span class="pagination-disabled">← Previous</span><% } %>
                            <span>Page <%= page %> of <%= pageCount %></span>
                            <% if (page < pageCount) { %><a href="/groups?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>&gradeId=<%= encodeURIComponent(gradeId) %>">Next →</a><% } else { %><span class="pagination-disabled">Next →</span><% } %>
                        </nav>
                    <% } %>
                <% } %>
            </div>
        </main>
    </div>
</body>
</html>
