# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB connection string (local, Atlas or Cosmos DB for MongoDB vCore)
MONGODB_URI=mongodb://127.0.0.1:27017/scheduling_app

# Auth. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=7d
COOKIE_NAME=tms_token
# Set to true when serving over HTTPS (required for Secure cookies)
COOKIE_SECURE=false
# Comma-separated list of allowed origins, or * during development
CLIENT_ORIGIN=*

CENTER_TIMEZONE=Africa/Algiers

# Used by `npm run db:seed` to create the initial teacher account.
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=change-this-password
TEACHER_NAME=Teacher
